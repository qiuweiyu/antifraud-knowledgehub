APP_ENV=development
APP_PORT=8080
DATABASE_DRIVER=postgres
DATABASE_DSN=host=localhost user=postgres password=postgres dbname=antifraud port=5432 sslmode=disable TimeZone=Asia/Shanghai
REDIS_ADDR=localhost:6379
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional LLM assistance remains disabled by default.
# The first bounded provider is OpenAI Responses with a fixed API origin and gpt-5.6 allowlist.
# Existing /analysis/text and /analysis/preview routes do NOT invoke this provider; a future
# explicit opt-in assisted-analysis transport will be designed separately before paid traffic is exposed.
LLM_ASSISTANCE_ENABLED=false
LLM_ASSISTANCE_PROVIDER=openai
LLM_ASSISTANCE_TIMEOUT=5s
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Controlled rule-submission transport is disabled by default.
RULE_SUBMISSIONS_ENABLED=false
RULE_SUBMISSION_WRITE_TOKEN=
RULE_SUBMISSION_CREDENTIAL_LIMIT=5
RULE_SUBMISSION_GLOBAL_LIMIT=50
RULE_SUBMISSION_RATE_WINDOW=10m

# Controlled maintainer review transport is also disabled by default.
# Use a token that is independent from RULE_SUBMISSION_WRITE_TOKEN.
RULE_SUBMISSION_REVIEWS_ENABLED=false
RULE_SUBMISSION_REVIEW_TOKEN=
RULE_SUBMISSION_REVIEW_ACTOR_LABEL=

# Controlled publication transport is also disabled by default.
# Use a token independent from both write and review credentials.
# The actor label is server-owned operational attribution, not user identity.
RULE_SUBMISSION_PUBLICATIONS_ENABLED=false
RULE_SUBMISSION_PUBLICATION_TOKEN=
RULE_SUBMISSION_PUBLICATION_ACTOR_LABEL=
